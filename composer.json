{
    "name": "gizmocraft/zendframework1-config",
    "description": "Zend Framework 1 Config component",
    "type": "library",
    "keywords": [
        "framework",
        "zf1"
    ],
    "homepage": "http://framework.zend.com/",
    "license": "BSD-3-Clause",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/gizmocraftcom/zf1-exception"
        },
        {
            "type": "vcs",
            "url": "https://github.com/gizmocraftcom/zf1-json"
        },
        {
            "type": "vcs",
            "url": "https://github.com/gizmocraftcom/zf1-xml"
        },
        {
            "type": "vcs",
            "url": "https://github.com/gizmocraftcom/zf1-server"
        }
    ],
    "require": {
        "php": ">=8.5",
        "gizmocraft/zendframework1-exception": "^2.0.0",
        "gizmocraft/zendframework1-json": "^2.0.0"
    },
    "autoload": {
        "psr-0": {
            "Zend_Config_": "src/"
        },
        "classmap": [
            "src/Zend/Config.php"
        ]
    },
    "autoload-dev": {
        "psr-0": {
            "Zend_": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4.8",
        "phpstan/phpstan": "^2.3.7",
        "friendsofphp/php-cs-fixer": "^3.95.32",
        "phpro/grumphp-shim": "^2.27.2"
    },
    "archive": {
        "exclude": [
            "/tests"
        ]
    },
    "scripts": {
        "test": "phpunit",
        "test-with-coverage": "phpunit --coverage-clover=clover.xml",
        "phpstan": "phpstan analyze -c phpstan.neon --no-progress --ansi --memory-limit=768M",
        "style-check": "php-cs-fixer fix --dry-run -vv"
    },
    "suggest": {
        "ext-SimpleXML": "Used for reading/writing XML config files",
        "ext-dom": "Used for reading/writing XML config files",
        "gizmocraft/zendframework1-xml": "Required if reading/writing XML config files"
    },
    "config": {
        "allow-plugins": {
            "phpro/grumphp-shim": true
        }
    }
}
